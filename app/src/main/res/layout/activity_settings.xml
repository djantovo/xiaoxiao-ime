<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ime_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/dict_loading"
            android:textColor="@color/key_text_dim"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_enable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="启用输入法（系统设置）" />

        <Button
            android:id="@+id/btn_picker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="切换输入法" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="词库"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pb_import"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_import_dir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="导入词库（选 dicts 文件夹）" />

        <Button
            android:id="@+id/btn_import_files"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="导入词库（选文件，可多选）" />

        <Button
            android:id="@+id/btn_dict_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="删除已导入词库" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="键盘"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/sw_vibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="按键震动" />

        <Switch
            android:id="@+id/sw_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="按键音" />

        <TextView
            android:id="@+id/tv_keyh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="按键高度：52dp"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/sb_keyh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="30" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="候选范围"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/sw_cat_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="人名 / 地名 / 名人 / 艺名" />

        <Switch
            android:id="@+id/sw_cat_pro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="专业词（诗词/武术/医学/药学/化学）" />

        <Switch
            android:id="@+id/sw_cat_fuzzy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="容错词（错音/方言/台风名）" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="4dp"
            android:text="说明：\n1. 词库不进 APK。在“导入词库”里选你的 dicts 文件夹，程序会在手机上把它编译成二进制索引，之后秒开。\n2. 导入耗时约 30~60 秒（第 1 遍统计、第 2 遍建索引），产出的 dict.bin 约 8~15MB。\n3. 手写识别需要 assets/model/ink.tflite + ink_labels.txt，没模型时手写面板只当笔迹板。\n4. 剪切板最多 300 条，正文不限字数；列表只存预览，点击才读全文。\n5. Android 10+ 需把本输入法设为默认输入法，才能记录其它 App 的剪贴板。\n6. 输入法里长按 😀 可直接打开本设置页。"
            android:textColor="@color/key_text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
