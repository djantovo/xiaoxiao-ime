<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ime_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ime_bg"
    android:orientation="vertical">

    <!-- 候选词条（自绘，含“更多”展开） -->
    <com.xx.ime.ui.CandidateBar
        android:id="@+id/candidate_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 键盘 / 手写 / emoji / 剪切板 面板都挂在这里 -->
    <FrameLayout
        android:id="@+id/panel_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 固定工具栏：emoji 键盘切换 全选 复制 粘贴 剪切板 -->
    <com.xx.ime.keyboard.KeyboardView
        android:id="@+id/kb_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
